@baseUrl = http://localhost:8080

### Add a meal to the timetable and registration form
POST {{baseUrl}}/api/admin/schedules
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "저녁식사",
  "description": "첫째 날 저녁 식사",
  "scheduleDate": "2027-01-15",
  "startsAt": "2027-01-15T18:00:00+09:00",
  "endsAt": "2027-01-15T19:00:00+09:00",
  "location": "식당",
  "category": "MEAL",
  "targetAudience": "ALL",
  "active": true,
  "displayOrder": 1080,
  "collectParticipation": true
}

> {%
    client.global.set("scheduleId", response.body.data.id);
    client.global.set("participationOptionId", response.body.data.participationOptionId);
%}

### Add a time-unspecified program that is not shown on the registration form
POST {{baseUrl}}/api/admin/schedules
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "운영진 안내",
  "scheduleDate": "2027-01-15",
  "category": "NOTICE",
  "targetAudience": "STAFF_ONLY",
  "active": true,
  "displayOrder": 0,
  "collectParticipation": false
}

### View the current timetable with participation counts
GET {{baseUrl}}/api/admin/schedules
Authorization: Bearer {{adminToken}}

### Update the linked schedule and registration item together
PATCH {{baseUrl}}/api/admin/schedules/{{scheduleId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "저녁식사",
  "description": "식수 인원 확인이 필요한 일정",
  "scheduleDate": "2027-01-15",
  "startsAt": "2027-01-15T18:30:00+09:00",
  "endsAt": "2027-01-15T19:30:00+09:00",
  "location": "식당",
  "category": "MEAL",
  "targetAudience": "ALL",
  "active": true,
  "displayOrder": 1110,
  "collectParticipation": true
}

### Hide the schedule and its linked registration item without deleting selections
PATCH {{baseUrl}}/api/admin/schedules/{{scheduleId}}/active
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "active": false
}
